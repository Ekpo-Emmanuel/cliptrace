{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cliptrace",
  "version": "0.3.0",
  "identifier": "dev.cliptrace.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Cliptrace",
        "width": 880,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Emmanuel Ekpo",
    "shortDescription": "Clipboard history for Windows with search by meaning",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "runtime/onnxruntime.dll": "onnxruntime.dll",
      "runtime/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "runtime/LICENSE-onnxruntime.txt": "LICENSE-onnxruntime.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
